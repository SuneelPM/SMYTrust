// Cloudflare Worker serving the static Astro build. No server code: requests are
// answered from dist/, with public/_headers and public/_redirects applied.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smytrust",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
