---
import Picture from './Picture.astro';
import type { TeamMember } from '../data/site';

interface Props {
  members: readonly TeamMember[];
}

const { members } = Astro.props;
---

{
  members.length > 0 ? (
    <div
      class="team-list mt-10"
      data-reveal-group
      data-reveal-stagger="0.08"
    >
      {members.map((m) => {
        const bioParagraphs = m.bio
          ? m.bio
              .split(/\n\s*\n/)
              .map((p) => p.replace(/\s+/g, ' ').trim())
              .filter(Boolean)
          : [];
        const bioPreview = bioParagraphs.join(' ');

        return (
          <article class="team-card group">
            <div class="team__profile">
              <div class="team__media">
                {m.image ? (
                  <Picture
                    src={m.image}
                    alt={m.name}
                    class="media-cover"
                    width="500"
                    height="620"
                    loading="lazy"
                    sizes="7rem"
                  />
                ) : (
                  <div class="team__media-placeholder" aria-hidden="true">
                    <span class="team__initials">
                      {m.name
                        .split(/\s+/)
                        .filter(Boolean)
                        .slice(0, 2)
                        .map((part) => part[0]?.toUpperCase())
                        .join('')}
                    </span>
                  </div>
                )}
              </div>
              <p class="team__role">{m.role}</p>
            </div>

            <div class="team__content">
              <h3 class="team__name">{m.name}</h3>

              {bioPreview && (
                <div class="team__bio-wrap" data-bio-wrap>
                  <p class="team__bio" data-bio>
                    {bioPreview}
                  </p>
                  {bioParagraphs.length > 1 && (
                    <div class="team__bio-full" data-bio-full hidden>
                      {bioParagraphs.map((paragraph) => (
                        <p>{paragraph}</p>
                      ))}
                    </div>
                  )}
                  <button
                    type="button"
                    class="team__bio-more"
                    data-bio-toggle
                    aria-expanded="false"
                    aria-label={`Show full bio for ${m.name}`}
                    hidden
                  >
                    <span data-bio-toggle-label>Read more</span>
                    <svg class="team__bio-more-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </button>
                </div>
              )}

              {m.qualification && (
                <div class="team__contact" aria-label={`Qualification of ${m.name}`}>
                  <p class="team__line team__line--stacked">
                    <span class="team__line-label">Qualification</span>
                    <span class="team__line-value">{m.qualification}</span>
                  </p>
                </div>
              )}
            </div>
          </article>
        );
      })}
    </div>
  ) : (
    <div
      class="placeholder mt-10 max-w-2xl"
      data-reveal="fade"
    >
      <span class="placeholder__tag">
        Trustee details in progress
      </span>

      <p
        class="mt-2 text-sm leading-relaxed"
        style="color: var(--c-muted)"
      >
        The governing board and trustee member details are currently being
        updated. The revised leadership list will be published shortly.
      </p>
    </div>
  )
}

<script>
  // Bios are CSS-clamped to 2 lines. If a bio's text actually overflows that
  // clamp, reveal a "···" button next to it; clicking toggles the full text.
  const wraps = Array.from(document.querySelectorAll<HTMLElement>('.team__bio-wrap'));

  const markOverflow = () => {
    for (const wrap of wraps) {
      const bio = wrap.querySelector<HTMLElement>('[data-bio]');
      const toggle = wrap.querySelector<HTMLButtonElement>('[data-bio-toggle]');
      if (!bio || !toggle) continue;
      if (bio.classList.contains('is-expanded')) continue;

      const overflowing = bio.scrollHeight > bio.clientHeight + 1;
      toggle.hidden = !overflowing;
    }
  };

  wraps.forEach((wrap) => {
    const bio = wrap.querySelector<HTMLElement>('[data-bio]');
    const full = wrap.querySelector<HTMLElement>('[data-bio-full]');
    const toggle = wrap.querySelector<HTMLButtonElement>('[data-bio-toggle]');
    const label = wrap.querySelector<HTMLElement>('[data-bio-toggle-label]');
    if (!bio || !toggle || !label) return;

    toggle.addEventListener('click', () => {
      const expanded = bio.classList.toggle('is-expanded');
      toggle.classList.toggle('is-open', expanded);
      toggle.setAttribute('aria-expanded', String(expanded));
      label.textContent = expanded ? 'Show less' : 'Read more';
      if (full) {
        full.hidden = !expanded;
        bio.hidden = expanded;
      }
    });
  });

  markOverflow();
  window.addEventListener('resize', markOverflow);
</script>

<style>
  .team-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 23rem), 1fr));
    gap: 1.1rem;
    align-items: start;
  }

  .team-card {
    position: relative;
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1.05rem;
    align-items: stretch;
    overflow: hidden;
    border: 1px solid var(--c-line);
    border-radius: 1rem;
    min-height: 10.75rem;
    padding: 0.95rem;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(255, 255, 255, 0.92)),
      var(--c-bg);
    box-shadow: 0 18px 48px -40px hsl(222 47% 11% / 0.62);
    transition:
      transform 0.5s var(--ease-out-expo),
      border-color 0.5s var(--ease-out-expo),
      box-shadow 0.5s var(--ease-out-expo);
  }

  .team-card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at 0% 0%, hsl(217 91% 60% / 0.06), transparent 40%);
    opacity: 0;
    transition: opacity 0.5s var(--ease-out-expo);
  }

  .team-card:hover {
    transform: translateY(-4px);
    border-color: hsl(217 91% 50% / 0.24);
    box-shadow: 0 26px 58px -38px hsl(222 47% 11% / 0.7);
  }

  .team-card:hover::before {
    opacity: 1;
  }

  .team__profile {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.55rem;
    min-width: 0;
  }

  .team__media {
    position: relative;
    width: 7rem;
    height: 8.15rem;
    overflow: hidden;
    border-radius: 0.85rem;
    background: var(--c-surface);
    box-shadow: inset 0 0 0 1px hsl(222 47% 11% / 0.06);
  }

  .team__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 18%;
    transition:
      transform 0.9s var(--ease-out-expo),
      filter 0.9s var(--ease-out-expo);
  }

  .team-card:hover .team__media img {
    transform: scale(1.045);
    filter: saturate(1.04) contrast(1.025);
  }

  .team__media-placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: linear-gradient(145deg, var(--c-brand-soft), var(--c-surface));
  }

  .team__initials {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--c-brand);
  }

  .team__role {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    min-height: 1.7rem;
    border-radius: 999px;
    background: var(--c-brand-soft);
    color: var(--c-brand);
    padding: 0.32rem 0.58rem;
    font-family: var(--font-display);
    font-size: 0.56rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  .team__content {
    position: relative;
    min-width: 0;
    display: grid;
    grid-template-rows: auto auto 1fr;
    align-content: start;
    padding-block: 0.1rem;
  }

  .team__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 750;
    line-height: 1.25;
    color: var(--c-ink);
    letter-spacing: -0.015em;
  }

  .team__bio-wrap {
    display: grid;
    gap: 0.3rem;
  }

  .team__bio {
    display: block;
    width: 100%;
    margin: 0;
    margin-top: 0.38rem;
    border: none;
    background: none;
    padding: 0;
    font: inherit;
    text-align: left;
    font-size: 0.76rem;
    line-height: 1.5;
    color: var(--c-muted);
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    display: -webkit-box;
    overflow: hidden;
    text-wrap: pretty;
  }

  .team__bio.is-expanded {
    -webkit-line-clamp: unset;
    overflow: visible;
  }

  .team__bio-full {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    margin-top: 0.38rem;
    font-size: 0.76rem;
    line-height: 1.5;
    color: var(--c-muted);
    text-wrap: pretty;
  }

  .team__bio-full p {
    margin: 0;
  }

  .team__bio-more {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    justify-self: start;
    border: none;
    background: none;
    padding: 0.15rem 0;
    color: var(--c-brand);
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    cursor: pointer;
    transition: color 0.25s var(--ease-out-expo);
  }

  .team__bio-more:hover,
  .team__bio-more:focus-visible {
    color: var(--c-ink);
  }

  .team__bio-more:focus-visible {
    outline: 2px solid var(--c-brand);
    outline-offset: 3px;
    border-radius: 0.25rem;
  }

  .team__bio-more-icon {
    width: 0.8rem;
    height: 0.8rem;
    transition: transform 0.35s var(--ease-out-expo);
  }

  .team__bio-more.is-open .team__bio-more-icon {
    transform: rotate(180deg);
  }

  .team__contact {
    display: grid;
    gap: 0.35rem;
    align-self: end;
    margin-top: 0.7rem;
    border-radius: 0.72rem;
    background: var(--c-surface);
    padding: 0.56rem 0.58rem;
  }

  .team__line {
    display: grid;
    grid-template-columns: 2.15rem minmax(0, 1fr);
    gap: 0.48rem;
    align-items: baseline;
    margin: 0;
    color: var(--c-ink);
    font-size: 0.7rem;
    line-height: 1.35;
  }

  .team__line-label {
    color: var(--c-muted);
    font-family: var(--font-display);
    font-size: 0.52rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .team__line-value {
    min-width: 0;
    font-weight: 600;
  }

  .team__line--stacked {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.15rem;
  }

  @media (max-width: 720px) {
    .team-list {
      grid-template-columns: 1fr;
    }

    .team-card {
      grid-template-columns: 6rem minmax(0, 1fr);
      min-height: auto;
    }

    .team__media {
      width: 6rem;
      height: 7rem;
    }
  }

  @media (max-width: 520px) {
    .team-card {
      grid-template-columns: 5.1rem minmax(0, 1fr);
      gap: 0.78rem;
      padding: 0.72rem;
      border-radius: 0.9rem;
    }

    .team__media {
      width: 5.1rem;
      height: 6.25rem;
      border-radius: 0.7rem;
    }

    .team__name {
      font-size: 0.95rem;
    }

    .team__role {
      min-height: 1.55rem;
      padding: 0.28rem 0.45rem;
      font-size: 0.54rem;
    }

    .team__bio {
      margin-top: 0.55rem;
      font-size: 0.72rem;
      line-height: 1.48;
    }
  }
</style>
