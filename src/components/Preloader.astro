---
import { u } from '../lib/url';
import { org } from '../data/site';
---

<div class="pre" data-preloader role="status" aria-live="polite" aria-label="Loading">
  <div class="pre__inner">
    <img src={u(org.logo)} alt="" width="72" height="72" class="pre__logo" />
    <p class="pre__name">{org.shortName}</p>
    <span class="pre__bar" aria-hidden="true"><i data-preloader-bar></i></span>
  </div>
</div>

<script>
  import { gsap } from '../lib/motion';

  const root = document.querySelector<HTMLElement>('[data-preloader]');

  if (root) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const bar = root.querySelector<HTMLElement>('[data-preloader-bar]');
    const inner = root.querySelector<HTMLElement>('.pre__inner');

    // Only show the loader on a genuine first visit. On repeat navigation the
    // page is warm and a splash screen is just an obstacle.
    let seen = false;
    try {
      seen = sessionStorage.getItem('smy-loaded') === '1';
    } catch {
      /* private mode — treat as first visit */
    }

    const finish = () => {
      document.documentElement.classList.remove('is-loading');
      try {
        sessionStorage.setItem('smy-loaded', '1');
      } catch {
        /* ignore */
      }
    };

    // Unconditional safety net: whatever happens above, the scroll lock and
    // overlay are gone by 4s.
    setTimeout(() => {
      root.remove();
      finish();
    }, 4000);

    if (seen || reduced) {
      root.remove();
      finish();
    } else {
      document.documentElement.classList.add('is-loading');

      const tl = gsap.timeline({
        onComplete: () => {
          root.remove();
          finish();
        },
      });

      tl.to(bar, { scaleX: 1, duration: 0.75, ease: 'power2.inOut' })
        .to(inner, { autoAlpha: 0, y: -14, duration: 0.35, ease: 'power2.in' }, '-=0.1')
        .to(root, { yPercent: -100, duration: 0.7, ease: 'expo.inOut' }, '-=0.05');

      // Hard cap: never hold the page hostage if `load` is slow or never fires.
      const kill = setTimeout(() => {
        tl.progress(1);
      }, 3000);
      tl.eventCallback('onComplete', () => {
        clearTimeout(kill);
        root.remove();
        finish();
      });
    }
  }
</script>

<style>
  .pre {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    background: var(--c-ink);
    color: #fff;

    /*
     * CSS-only failsafe. If the module script never loads (blocked, offline,
     * parse error) the JS would never remove this overlay and the site would
     * be unreachable. This dismisses it after 4s with no JS involved; when the
     * script does run it removes the element long before this fires.
     */
    animation: pre-failsafe 0.4s ease 4s forwards;
  }

  @keyframes pre-failsafe {
    to {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }

  .pre__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .pre__logo {
    width: 4.5rem;
    height: 4.5rem;
    object-fit: contain;
    animation: pre-pulse 1.6s var(--ease-out-expo) infinite;
  }

  .pre__name {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
  }

  .pre__bar {
    display: block;
    width: 8rem;
    height: 2px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    overflow: hidden;
  }

  .pre__bar i {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--c-accent);
    transform: scaleX(0);
    transform-origin: left center;
  }

  @keyframes pre-pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.9;
    }
    50% {
      transform: scale(1.06);
      opacity: 1;
    }
  }

  /* No JS: the loader must never trap the page. */
  :global(.no-js) .pre {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .pre {
      display: none;
    }

    .pre__logo {
      animation: none;
    }
  }
</style>
