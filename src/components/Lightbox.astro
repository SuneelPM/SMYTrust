---
/**
 * Click any [data-lightbox] figure on the page to open it full-screen.
 * Arrow keys and swipe move between items; Escape closes.
 */
---

<div class="lb" data-lightbox-root hidden>
  <button type="button" class="lb__close" data-lb-close aria-label="Close">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"
      ><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg
    >
  </button>

  <button type="button" class="lb__nav lb__nav--prev" data-lb-prev aria-label="Previous image">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"
      ><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg
    >
  </button>

  <figure class="lb__figure" role="dialog" aria-modal="true" aria-label="Image viewer">
    <img src="" alt="" data-lb-img />
    <figcaption data-lb-caption></figcaption>
  </figure>

  <button type="button" class="lb__nav lb__nav--next" data-lb-next aria-label="Next image">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"
      ><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg
    >
  </button>

  <p class="lb__count" data-lb-count></p>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-lightbox-root]');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-lightbox]'));

  if (root && items.length) {
    const imgEl = root.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const capEl = root.querySelector<HTMLElement>('[data-lb-caption]')!;
    const countEl = root.querySelector<HTMLElement>('[data-lb-count]')!;

    let index = 0;
    let lastFocused: HTMLElement | null = null;

    function show(i: number) {
      index = (i + items.length) % items.length;
      const source = items[index]!.querySelector('img')!;
      imgEl.src = source.currentSrc || source.src;
      imgEl.alt = source.alt;
      capEl.textContent = source.alt;
      countEl.textContent = `${index + 1} / ${items.length}`;
    }

    function open(i: number) {
      lastFocused = document.activeElement as HTMLElement;
      show(i);
      root!.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      root!.querySelector<HTMLButtonElement>('[data-lb-close]')?.focus();
    }

    function close() {
      root!.hidden = true;
      document.documentElement.style.overflow = '';
      lastFocused?.focus();
    }

    items.forEach((item, i) => {
      item.addEventListener('click', () => open(i));
      item.setAttribute('role', 'button');
      item.setAttribute('tabindex', '0');
      item.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          open(i);
        }
      });
    });

    root.querySelector('[data-lb-close]')?.addEventListener('click', close);
    root.querySelector('[data-lb-next]')?.addEventListener('click', () => show(index + 1));
    root.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(index - 1));
    root.addEventListener('click', (e) => {
      if (e.target === root) close();
    });

    document.addEventListener('keydown', (e) => {
      if (root.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowRight') show(index + 1);
      if (e.key === 'ArrowLeft') show(index - 1);
    });

    let startX = 0;
    root.addEventListener('touchstart', (e) => { startX = e.touches[0]!.clientX; }, { passive: true });
    root.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0]!.clientX - startX;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    }, { passive: true });
  }
</script>

<style>
  .lb {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: clamp(1rem, 4vw, 3rem);
    background: hsl(222 47% 6% / 0.94);
    backdrop-filter: blur(6px);
  }

  .lb__figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  .lb__figure img {
    max-width: 100%;
    max-height: 78vh;
    object-fit: contain;
    border-radius: 0.75rem;
  }

  .lb__figure figcaption {
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.65);
    text-align: center;
  }

  .lb__close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 2;
  }

  .lb__close,
  .lb__nav {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    color: #fff;
    transition: all 0.3s var(--ease-out-expo);
    cursor: pointer;
  }

  .lb__close:hover,
  .lb__nav:hover {
    background: #fff;
    color: hsl(222 47% 11%);
    border-color: transparent;
  }

  .lb__close svg,
  .lb__nav svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .lb__count {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.7);
  }

  @media (max-width: 640px) {
    .lb__nav {
      position: absolute;
      bottom: 1.25rem;
    }

    .lb__nav--prev {
      left: 1.25rem;
    }

    .lb__nav--next {
      right: 1.25rem;
    }

    .lb {
      grid-template-columns: 1fr;
    }
  }

  :global([data-lightbox]) {
    cursor: zoom-in;
  }
</style>
