---
import { u } from '../lib/url';
import Picture from './Picture.astro';
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  image?: string;
}

const {
  eyebrow,
  title,
  lead,
  image = '/images/side-view-people-celebrating-eid-al-fitr-scaled.jpg',
} = Astro.props;

const crumbs = Astro.url.pathname.split('/').filter(Boolean);
---

<section class="phero">
  {/*
    The scoped class must sit on an element in THIS component. Putting it on the
    Picture component would target markup rendered inside that component, which
    never receives this file's scope id, so the layout rules silently would not
    apply. Verified on every build by scripts/verify.mjs.
  */}
  <div class="phero__bg" data-parallax="50" aria-hidden="true">
    <Picture
      src={u(image)}
      alt=""
      class="media-cover"
      width="1920"
      height="900"
      fetchpriority="high"
      loading="eager"
      sizes="100vw"
    />
  </div>
  <div class="phero__scrim"></div>

  <div class="phero__fg container-x">
    <nav aria-label="Breadcrumb" class="phero__crumbs">
      <a href={u('/')}>Home</a>
      {crumbs.map((c) => (
        <>
          <span aria-hidden="true">/</span>
          <span class="capitalize">{c.replace(/-/g, ' ')}</span>
        </>
      ))}
    </nav>

    <p class="eyebrow eyebrow--light enter-up mt-6"><span class="eyebrow-dot"></span>{eyebrow}</p>
    <h1 class="h1 mt-4 text-white" data-split-text>{title}</h1>
    {lead && <p class="phero__lead enter-up">{lead}</p>}
  </div>
</section>

<style>
  /* Sizing, scrim and image treatment are deliberately identical to the
     homepage hero (HeroCarousel.astro) so every page opens the same way. */
  .phero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    isolation: isolate;
    background: var(--c-ink);
  }

  .phero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 128%;
    z-index: -2;
    overflow: hidden;
  }

  .phero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        to top,
        hsl(222 47% 8% / 0.92) 0%,
        hsl(222 47% 8% / 0.55) 40%,
        hsl(222 47% 8% / 0.14) 72%,
        hsl(222 47% 8% / 0.5) 100%
      ),
      linear-gradient(to right, hsl(222 47% 8% / 0.78) 0%, hsl(222 47% 8% / 0.24) 58%, transparent 88%);
  }

  .phero__fg {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-top: 10rem;
    padding-bottom: clamp(4.5rem, 11vh, 8.5rem);
    color: #fff;
  }

  .phero__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
  }

  .phero__crumbs a:hover {
    color: #fff;
  }

  .phero__lead {
    margin-top: 1.25rem;
    max-width: 42rem;
    font-size: 1.0625rem;
    line-height: 1.72;
    color: rgba(255, 255, 255, 0.78);
  }
</style>
