---
import { u } from '../lib/url';
import { org } from '../data/site';
import Icon from './Icon.astro';

const items = [
  {
    icon: 'pin',
    label: `${org.address.city} — ${org.address.pin}`,
    href: `https://www.google.com/maps/search/?api=1&query=${org.mapQuery}`,
    aria: `Our office: ${org.addressOneLine}`,
    external: true,
  },
  {
    icon: 'phone',
    label: org.phone,
    href: org.phoneHref,
    aria: `Call us on ${org.phone}`,
    external: false,
  },
  {
    icon: 'mail',
    label: org.email,
    href: org.emailHref,
    aria: `Email us at ${org.email}`,
    external: false,
  },
];
---

<aside class="rail" aria-label="Contact details">
  <ul>
    {
      items.map((item) => (
        <li>
          <a
            href={u(item.href)}
            class="rail__item"
            aria-label={item.aria}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
          >
            <span class="rail__icon" aria-hidden="true">
              <Icon name={item.icon} />
            </span>
            <span class="rail__label" aria-hidden="true">
              {item.label}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</aside>

<style>
  .rail {
    position: fixed;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 45;
    pointer-events: none;
  }

  .rail ul {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .rail li {
    display: flex;
  }

  .rail__item {
    pointer-events: auto;
    display: flex;
    align-items: center;
    max-width: 3rem;
    background: var(--c-bg);
    color: var(--c-ink);
    border: 1px solid var(--c-line);
    border-left: 0;
    border-radius: 0 999px 999px 0;
    box-shadow: 0 10px 30px -14px hsl(222 47% 11% / 0.35);
    overflow: hidden;
    transition:
      max-width 0.55s var(--ease-out-expo),
      background-color 0.35s ease,
      color 0.35s ease,
      box-shadow 0.35s ease;
  }

  .rail__item:hover,
  .rail__item:focus-visible {
    max-width: 30rem;
    background: var(--c-brand);
    color: #fff;
    border-color: var(--c-brand);
    box-shadow: 0 14px 34px -12px hsl(217 91% 50% / 0.55);
  }

  .rail__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    flex: none;
  }

  .rail__icon :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
    transition: transform 0.4s var(--ease-out-expo);
  }

  .rail__item:hover .rail__icon :global(svg) {
    transform: scale(1.1);
  }

  .rail__label {
    padding-right: 1.25rem;
    white-space: nowrap;
    font-size: 0.8125rem;
    font-weight: 500;
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.4s var(--ease-out-expo),
      transform 0.5s var(--ease-out-expo);
  }

  .rail__item:hover .rail__label,
  .rail__item:focus-visible .rail__label {
    opacity: 1;
    transform: translateX(0);
  }

  /* Too narrow to sit beside content — the same details are in the mobile
     menu and the footer, so hide the rail rather than overlap the page. */
  @media (max-width: 1023px) {
    .rail {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail__item,
    .rail__label,
    .rail__icon :global(svg) {
      transition: none;
    }
  }
</style>
