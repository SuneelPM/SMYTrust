---
import { u } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';

const target = u('/activities/');
---

<BaseLayout
  title="Gallery Redirect"
  description="Gallery photographs are now part of the Activities page for Sri Matha Yellamanba Services."
>
  <section class="section-y">
    <div class="container-x">
      <h1 class="h2">Gallery moved to Activities</h1>
      <p class="mt-4 max-w-2xl leading-relaxed" style="color: var(--c-muted)">
        The gallery is now maintained on the Activities page.
      </p>
      <p class="mt-6">
        <a href={target} class="btn btn-primary">Open Activities</a>
      </p>
    </div>
  </section>

  <script is:inline define:vars={{ target }}>
    window.location.replace(target + window.location.search + window.location.hash);
  </script>
</BaseLayout>
