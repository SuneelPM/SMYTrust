---
import { u } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { org, donate, causes } from '../data/site';

// Bank identifiers come from the environment and may legitimately be absent
// (e.g. a public preview build). Only render the rows that have a value.
const bankRows = (
  [
    ['Account name', donate.bank.accountName],
    ['Account number', donate.bank.account],
    ['CIF number', donate.bank.cif],
    ['IFSC code', donate.bank.ifsc],
    ['MICR code', donate.bank.micr],
    ['Account type', donate.bank.product],
    ['Currency', donate.bank.currency],
  ] as const
).filter(([, v]) => typeof v === 'string' && v.trim().length > 0);

const hasBankDetails = Boolean(donate.bank.account && donate.bank.ifsc);

const ways = [
  {
    icon: 'shield',
    title: 'Bank transfer / NEFT',
    body: 'Transfer directly using the account details on this page. Email your reference number and we will send a receipt.',
  },
  {
    icon: 'heart',
    title: 'Monthly giving',
    body: 'Set up a standing instruction with your bank. Regular giving lets us plan programmes months ahead instead of reacting.',
  },
  {
    icon: 'book',
    title: 'Corporate & CSR',
    body: 'Structured partnerships with costed project plans and reporting aligned to your compliance calendar.',
  },
];
---

<BaseLayout
  title="Donate"
  description={`Support ${org.name}. Every donation is receipted, tax-exempt, and reported back with the outcome it funded.`}
  overlay
>
  <PageHero
    eyebrow="Donate"
    title={donate.heading}
    lead={donate.lead}
    image="/images/9917941-scaled.jpg"
  />

  <!-- Why + trust -->
  <section class="section-y">
    <div class="container-x">
      <div class="grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
        <div>
          <p class="eyebrow" data-reveal="fade"><span class="eyebrow-dot"></span>Why your donation matters</p>
          <h2 class="h2 mt-5" data-split-text>Where your money goes</h2>
          <p class="lead mt-6" data-reveal="up">{donate.body}</p>

          <ul class="mt-8 space-y-3" data-reveal-group>
            {
              donate.trust.map((t) => (
                <li class="flex items-center gap-3 text-[0.9375rem]">
                  <span class="check" aria-hidden="true">
                    ✓
                  </span>
                  <span style="color: var(--c-muted)">{t}</span>
                </li>
              ))
            }
          </ul>

          <div class="mt-10 grid gap-3 sm:grid-cols-2" data-reveal-group>
            {
              causes.slice(0, 4).map((c) => (
                <div class="minicause">
                  <span class="icon-badge"><Icon name={c.icon} /></span>
                  <p class="font-display mt-3 text-sm font-semibold">{c.title}</p>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Bank panel -->
        <div class="bank" data-reveal="right">
          <p class="bank__head">Bank transfer details</p>
          {!hasBankDetails && (
            <p class="mt-4 text-sm leading-relaxed" style="color: var(--c-muted)">
              Account details are available on request — email
              <a href={org.emailHref} class="link-underline font-medium">{org.email}</a>
              or call <a href={org.phoneHref} class="link-underline font-medium">{org.phone}</a>
              and we will send them with your receipt.
            </p>
          )}
          <dl class="mt-6">
            {
              bankRows.map(([k, v]) => (
                <div class="bank__row">
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))
            }
          </dl>

          {hasBankDetails && (
            <button type="button" class="btn btn-outline mt-6 w-full" data-copy={donate.bank.account}>
              Copy account number
            </button>
          )}

          <p class="mt-6 text-xs leading-relaxed" style="color: var(--c-muted)">
            After transferring, email your reference number to
            <a href={`mailto:${donate.bank.email}`} class="link-underline font-medium">{donate.bank.email}</a>
            so we can issue your receipt and tax exemption certificate.
          </p>
          <p class="mt-3 text-xs" style="color: var(--c-muted)">GST {org.gst} · CSR {org.csr}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Ways to donate -->
  <section class="section-y pt-0">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow" data-reveal="fade"><span class="eyebrow-dot"></span>Ways to give</p>
        <h2 class="h2 mt-5" data-split-text>Choose what suits you</h2>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-3" data-reveal-group>
        {
          ways.map((w) => (
            <article class="card p-7">
              <span class="icon-badge"><Icon name={w.icon} /></span>
              <h3 class="h3 mt-5">{w.title}</h3>
              <p class="mt-2.5 text-[0.9375rem] leading-relaxed" style="color: var(--c-muted)">
                {w.body}
              </p>
            </article>
          ))
        }
      </div>

      <div class="placeholder mt-10" data-reveal="fade">
        <span class="placeholder__tag">Optional upgrade</span>
        <p class="mt-2 text-sm leading-relaxed" style="color: var(--c-muted)">
          To accept cards, UPI and net banking directly on this page, create a Razorpay or Instamojo
          payment link and we will wire it to the buttons here — no server needed. Send us the link
          when the account is approved.
        </p>
      </div>
    </div>
  </section>

  <!-- Transparency -->
  <section class="section-y" style="background: var(--c-surface)">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <h2 class="h2" data-split-text>Transparency &amp; trust</h2>
          <p class="lead mt-5 max-w-xl" data-reveal="up">
            We ensure that every contribution is utilised responsibly, transparently and effectively —
            and we put that in writing, to you, with dates and numbers.
          </p>
        </div>
        <div class="flex flex-wrap gap-4" data-reveal="up">
          <a href={u('/certificate/')} class="btn btn-primary btn-lg">
            View our certificates
            <Icon name="arrow-right" class="btn-arrow" />
          </a>
          <a href={u('/contact/')} class="btn btn-outline btn-lg">Ask a question</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const value = btn.dataset.copy ?? '';
      const original = btn.textContent;
      try {
        await navigator.clipboard.writeText(value);
        btn.textContent = 'Copied ✓';
      } catch {
        btn.textContent = value;
      }
      setTimeout(() => {
        btn.textContent = original;
      }, 2000);
    });
  });
</script>

<style>
  .bank {
    border: 1px solid var(--c-line);
    border-radius: 1.5rem;
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    background: var(--c-brand-soft);
  }

  .bank__head {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-brand);
  }

  .bank__row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px dashed hsl(217 91% 50% / 0.25);
    padding-block: 0.8rem;
    font-size: 0.875rem;
  }

  .bank__row:last-child {
    border-bottom: 0;
  }

  .bank__row dt {
    color: var(--c-muted);
    flex: none;
  }

  .bank__row dd {
    font-weight: 600;
    text-align: right;
    font-variant-numeric: tabular-nums;
    word-break: break-word;
  }

  .minicause {
    border: 1px solid var(--c-line);
    border-radius: 1rem;
    padding: 1.15rem;
  }
</style>
