---
import { u } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { org, social, activeSocial } from '../data/site';

/**
 * Static contact form via Web3Forms — no server required, works on Hostinger
 * shared hosting. Put your key in .env as PUBLIC_WEB3FORMS_KEY.
 * Get a free key at https://web3forms.com (it emails submissions to you).
 */
const formKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const mapSrc = `https://www.google.com/maps?q=${org.mapQuery}&output=embed`;
---

<BaseLayout
  title="Contact Us"
  description={`Get in touch with ${org.name} — ${org.addressOneLine}. Phone ${org.phone}, email ${org.email}.`}
  overlay
>
  <PageHero
    eyebrow="Contact Us"
    title="Get in touch"
    lead="Questions, partnership enquiries, volunteering or media — reach us on any channel below."
    image="/images/portrait-male-friends-sharing-affectionate-moment-friendship-scaled.jpg"
  />

  <section class="section-y">
    <div class="container-x">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
        <!-- Details -->
        <div>
          <p class="eyebrow" data-reveal="fade"><span class="eyebrow-dot"></span>Reach us</p>
          <h2 class="h2 mt-5" data-split-text>Talk to the team</h2>

          <div class="mt-9 space-y-4" data-reveal-group>
            <a href={`https://www.google.com/maps/search/?api=1&query=${org.mapQuery}`} target="_blank" rel="noopener noreferrer" class="cbox">
              <span class="icon-badge"><Icon name="pin" /></span>
              <span>
                <span class="cbox__label">Office</span>
                <span class="cbox__value">
                  {org.address.line1}<br />{org.address.line2}<br />{org.address.line3}<br />{org.address.city} — {org.address.pin}
                </span>
              </span>
            </a>

            <a href={org.phoneHref} class="cbox">
              <span class="icon-badge"><Icon name="phone" /></span>
              <span>
                <span class="cbox__label">Phone</span>
                <span class="cbox__value">{org.phone}</span>
              </span>
            </a>

            <a href={org.emailHref} class="cbox">
              <span class="icon-badge"><Icon name="mail" /></span>
              <span>
                <span class="cbox__label">Email</span>
                <span class="cbox__value">{org.email}</span>
              </span>
            </a>

            <div class="cbox">
              <span class="icon-badge"><Icon name="clock" /></span>
              <span>
                <span class="cbox__label">Office hours</span>
                <span class="cbox__value">
                  Monday – Saturday, 10:00 – 18:00 IST
                  <em class="cbox__note">Confirm your preferred hours and we will update this.</em>
                </span>
              </span>
            </div>
          </div>

          <div class="mt-9">
            <p class="cbox__label">Follow us</p>
            <ul class="mt-3 flex gap-2.5">
              {
                social.map((s) =>
                  s.href ? (
                    <li>
                      <a
                        href={u(s.href)}
                        class="social"
                        aria-label={s.name}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <Icon name={s.icon} size={16} />
                      </a>
                    </li>
                  ) : (
                    <li>
                      <span class="social social--pending" role="img" aria-label={`${s.name} profile`}>
                        <Icon name={s.icon} size={16} />
                      </span>
                    </li>
                  ),
                )
              }
            </ul>
            {activeSocial.length === 0 && (
              <p class="mt-2.5 text-[11px]" style="color: var(--c-muted)">
                Coming soon.
              </p>
            )}
          </div>

          <p class="mt-9 text-xs" style="color: var(--c-muted)">CSR {org.csr}</p>
        </div>

        <!-- Form -->
        <div class="formcard" data-reveal="right">
          <h2 class="h3">Send us a message</h2>
          <p class="mt-2 text-sm" style="color: var(--c-muted)">
            We reply to every enquiry within two working days.
          </p>

          {
            !formKey && (
              <div class="notice mt-6">
                <span class="notice__tag">Email enquiry</span>
                <p class="mt-2 text-sm leading-relaxed" style="color: var(--c-muted)">
                  Submitting this form will open your email app addressed to {org.email}.
                </p>
              </div>
            )
          }

          <form
            class="mt-7 grid gap-4"
            data-contact-form
            action={formKey ? 'https://api.web3forms.com/submit' : org.emailHref}
            method={formKey ? 'POST' : 'GET'}
          >
            {formKey && <input type="hidden" name="access_key" value={formKey} />}
            <input type="hidden" name="subject" value={`New enquiry from ${org.shortName} website`} />
            <input type="hidden" name="from_name" value={org.name} />
            <!-- Honeypot: bots fill this, humans never see it -->
            <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

            <div class="grid gap-4 sm:grid-cols-2">
              <label class="field">
                <span class="field__label">First name <b>*</b></span>
                <input type="text" name="first_name" required autocomplete="given-name" placeholder="Your first name" />
              </label>
              <label class="field">
                <span class="field__label">Last name</span>
                <input type="text" name="last_name" autocomplete="family-name" placeholder="Your last name" />
              </label>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <label class="field">
                <span class="field__label">Email <b>*</b></span>
                <input type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
              </label>
              <label class="field">
                <span class="field__label">Phone</span>
                <input type="tel" name="phone" autocomplete="tel" inputmode="tel" placeholder="+91 00000 00000" />
              </label>
            </div>

            <label class="field">
              <span class="field__label">I am writing about</span>
              <select name="topic">
                <option>General enquiry</option>
                <option>Making a donation</option>
                <option>CSR partnership</option>
                <option>Document request</option>
                <option>Volunteering</option>
                <option>Media / press</option>
              </select>
            </label>

            <label class="field">
              <span class="field__label">Message <b>*</b></span>
              <textarea name="message" rows="5" required placeholder="How can we help?"></textarea>
            </label>

            <button type="submit" class="btn btn-primary btn-lg mt-2 w-full">
              Send message
              <Icon name="arrow-right" class="btn-arrow" />
            </button>

            <p class="form__status" data-form-status role="status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Map -->
  <section class="pb-0">
    <h2 class="sr-only">Our location on a map</h2>
    <iframe
      src={mapSrc}
      class="map"
      title={`Map showing ${org.name} in ${org.address.city}`}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen></iframe>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');

  if (form) {
    const params = new URLSearchParams(window.location.search);
    const topic = params.get('topic');
    const message = params.get('message');
    const topicField = form.elements.namedItem('topic') as HTMLSelectElement | null;
    const messageField = form.elements.namedItem('message') as HTMLTextAreaElement | null;

    if (topic && topicField) {
      const hasOption = Array.from(topicField.options).some((option) => option.value === topic);
      if (!hasOption) topicField.add(new Option(topic, topic));
      topicField.value = topic;
    }

    if (message && messageField) {
      messageField.value = message;
    }
  }

  // Only intercept when the form actually posts to Web3Forms.
  if (form && status && form.method.toLowerCase() === 'post') {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const original = button.innerHTML;

      button.disabled = true;
      button.textContent = 'Sending…';
      status.textContent = '';
      status.className = 'form__status';

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
        });
        const data = await res.json();

        if (res.ok && data.success) {
          form.reset();
          status.textContent = 'Thank you — your message is on its way. We reply within two working days.';
          status.classList.add('is-ok');
        } else {
          throw new Error(data.message || 'Submission failed');
        }
      } catch {
        status.textContent = 'Something went wrong. Please email us directly instead.';
        status.classList.add('is-error');
      } finally {
        button.disabled = false;
        button.innerHTML = original;
      }
    });
  }
</script>

<style>
  .cbox {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
    border: 1px solid var(--c-line);
    border-radius: 1.1rem;
    padding: 1.35rem;
    transition: all 0.4s var(--ease-out-expo);
  }

  a.cbox:hover {
    border-color: var(--c-brand);
    background: var(--c-brand-soft);
  }

  .cbox__label {
    display: block;
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .cbox__value {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    font-weight: 500;
  }

  .cbox__note {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.75rem;
    font-style: normal;
    font-weight: 400;
    color: var(--c-muted);
  }

  .social {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 999px;
    border: 1px solid var(--c-line);
    color: var(--c-muted);
    transition: all 0.35s var(--ease-out-expo);
  }

  .social--pending {
    opacity: 0.4;
    cursor: default;
  }

  .social--pending:hover {
    background: transparent;
    border-color: var(--c-line);
    color: var(--c-muted);
    transform: none;
  }

  .social:not(.social--pending):hover {
    background: var(--c-brand);
    border-color: transparent;
    color: #fff;
    transform: translateY(-2px);
  }

  .formcard {
    border: 1px solid var(--c-line);
    border-radius: 1.5rem;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    background: var(--c-surface);
  }

  .notice {
    border: 1px solid var(--c-line);
    border-radius: 1rem;
    background: var(--c-bg);
    padding: 1rem;
  }

  .notice__tag {
    display: inline-flex;
    border-radius: 999px;
    background: var(--c-brand-soft);
    color: var(--c-brand);
    padding: 0.28rem 0.6rem;
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .field {
    display: block;
  }

  .field__label {
    display: block;
    margin-bottom: 0.45rem;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .field__label b {
    color: var(--c-brand);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    background: var(--c-bg);
    border: 1px solid var(--c-line);
    border-radius: 0.7rem;
    padding: 0.75rem 0.95rem;
    font-size: 0.9375rem;
    font-family: inherit;
    color: var(--c-ink);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: hsl(215 16% 62%);
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--c-brand);
    box-shadow: 0 0 0 3px hsl(217 91% 50% / 0.14);
  }

  .field textarea {
    resize: vertical;
  }

  .form__status {
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .form__status.is-ok {
    color: hsl(160 84% 28%);
  }

  .form__status.is-error {
    color: hsl(0 72% 45%);
  }

  .map {
    display: block;
    width: 100%;
    height: clamp(20rem, 42vh, 27rem);
    border: 0;
    filter: grayscale(0.15);
  }
</style>
