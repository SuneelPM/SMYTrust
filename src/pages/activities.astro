---
import { u } from '../lib/url';
import Picture from '../components/Picture.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Lightbox from '../components/Lightbox.astro';
import CtaBand from '../components/CtaBand.astro';
import { gallery } from '../data/media';
---

<BaseLayout
  title="Activities"
  description="Recent field activities and community programmes run by Sri Matha Yellamanba Services in and around Vijayawada."
  overlay
>
  <PageHero
    eyebrow="Activities"
    title="Our work, documented"
    lead="Photographs from outreach programmes, health camps, distribution drives and community events."
    image="/images/side-view-people-celebrating-eid-al-fitr-scaled.jpg"
  />

  <section class="section-y">
    <div class="container-x">
      {
        gallery.length > 0 ? (
          <>
            <div class="gallery-head" data-reveal="fade">
              <p class="gallery-head__kicker">Field moments</p>
              <p class="gallery-head__copy">
                Click any photograph to open the viewer. Use arrows, thumbnails, scroll wheel, or swipe to move through the collection.
              </p>
            </div>

            <div class="masonry" data-reveal-group data-reveal-stagger="0.03">
              {
                gallery.map((g, i) => (
                  <button
                    type="button"
                    class="masonry__item"
                    data-lightbox
                    aria-label={`Open activity image ${i + 1}: ${g.alt}`}
                  >
                    <Picture
                      src={u(g.src)}
                      alt={g.alt}
                      class="media-cover"
                      width="600"
                      height="600"
                      loading={i < 8 ? 'eager' : 'lazy'}
                      decoding="async"
                      sizes="(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw"
                    />
                    <span class="masonry__shade" aria-hidden="true"></span>
                    <span class="masonry__cap">{g.alt}</span>
                    <span class="masonry__zoom" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none">
                        <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.6"></circle>
                        <path d="M11 8.5v5M8.5 11h5M16 16l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                      </svg>
                    </span>
                  </button>
                ))
              }
            </div>
          </>
        ) : (
          <div class="placeholder max-w-2xl mx-auto text-center py-16 px-6 sm:px-12" data-reveal="fade">
            <span class="placeholder__tag">Activity documentation</span>
            <h2 class="font-display font-bold text-2xl sm:text-3xl mt-4" style="color: var(--c-ink)">
              Field photographs will be published here
            </h2>
            <p class="mt-4 text-base leading-relaxed" style="color: var(--c-muted)">
              We are currently curating and uploading new high-resolution photographs documenting our recent field programmes, welfare distribution drives, and community initiatives. Please check back soon.
            </p>
          </div>
        )
      }
    </div>
  </section>

  <Lightbox />
  <CtaBand />
</BaseLayout>

<style>
  .gallery-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.5rem;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 1.35rem;
    border-bottom: 1px solid var(--c-line);
    padding-bottom: 1.1rem;
  }

  .gallery-head__kicker {
    font-family: var(--font-display);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-brand);
  }

  .gallery-head__copy {
    max-width: 42rem;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--c-muted);
  }

  .masonry {
    columns: 2;
    column-gap: 0.75rem;
    perspective: 1200px;
  }

  @media (min-width: 640px) {
    .masonry {
      columns: 3;
      column-gap: 1rem;
    }
  }

  @media (min-width: 1024px) {
    .masonry {
      columns: 4;
    }
  }

  .masonry__item {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    break-inside: avoid;
    margin-bottom: 0.75rem;
    border-radius: 1.15rem;
    overflow: hidden;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    text-align: left;
    box-shadow: 0 22px 55px -42px hsl(222 47% 11% / 0.65);
    transform: translateZ(0);
    cursor: zoom-in;
    transition:
      transform 0.65s var(--ease-out-expo),
      box-shadow 0.65s var(--ease-out-expo),
      border-color 0.65s var(--ease-out-expo);
    animation: gallery-rise both;
    animation-timeline: view();
    animation-range: entry 0% cover 34%;
  }

  .masonry__item:nth-child(4n + 2) {
    transform: translateY(1.2rem);
  }

  .masonry__item:nth-child(5n + 3) {
    border-radius: 1.65rem 1rem 1.65rem 1rem;
  }

  .masonry__item:hover {
    transform: translateY(-0.55rem) rotateX(2deg) rotateZ(-0.6deg);
    border-color: hsl(217 91% 50% / 0.28);
    box-shadow: 0 36px 80px -44px hsl(222 47% 11% / 0.75);
  }

  .masonry__item:focus-visible {
    outline: 3px solid var(--c-brand);
    outline-offset: 4px;
  }

  @media (min-width: 640px) {
    .masonry__item {
      margin-bottom: 1rem;
    }
  }

  .masonry__item img {
    display: block;
    width: 100%;
    height: auto;
    transition:
      transform 0.9s var(--ease-out-expo),
      filter 0.9s var(--ease-out-expo);
  }

  .masonry__item:hover img,
  .masonry__item:focus-visible img {
    transform: scale(1.08);
    filter: saturate(1.08) contrast(1.04);
  }

  .masonry__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, transparent 22%, hsl(222 47% 8% / 0.08) 55%, hsl(222 47% 8% / 0.58)),
      radial-gradient(circle at 50% 40%, transparent 0 18%, hsl(222 47% 8% / 0.2) 58%);
    opacity: 0;
    transition: opacity 0.45s var(--ease-out-expo);
  }

  .masonry__item:hover .masonry__shade,
  .masonry__item:focus-visible .masonry__shade {
    opacity: 1;
  }

  .masonry__cap {
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 2;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    color: var(--c-ink);
    padding: 0.45rem 0.75rem;
    font-size: 0.72rem;
    line-height: 1.35;
    font-weight: 600;
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity 0.35s ease,
      transform 0.35s var(--ease-out-expo);
    backdrop-filter: blur(12px);
  }

  .masonry__item:hover .masonry__cap,
  .masonry__item:focus-visible .masonry__cap {
    opacity: 1;
    transform: translateY(0);
  }

  .masonry__zoom {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    color: #fff;
    opacity: 0;
    transition: opacity 0.4s var(--ease-out-expo);
  }

  .masonry__item:hover .masonry__zoom,
  .masonry__item:focus-visible .masonry__zoom {
    opacity: 1;
  }

  .masonry__zoom svg {
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 999px;
    background: hsl(222 47% 8% / 0.45);
    padding: 0.34rem;
    box-sizing: content-box;
    backdrop-filter: blur(10px);
  }

  @keyframes gallery-rise {
    from {
      opacity: 0.35;
      transform: translateY(2rem) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .masonry__item,
    .masonry__item img,
    .masonry__cap,
    .masonry__zoom,
    .masonry__shade {
      animation: none;
      transition: none;
    }
  }
</style>
