---
import { u } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { org, csr, donate } from '../data/site';

const sdgs = [
  'SDG 4 — Quality Education',
  'SDG 5 — Gender Equality',
  'SDG 8 — Decent Work',
  'SDG 10 — Reduced Inequalities',
];
---

<BaseLayout
  title="CSR Fund"
  description="Partner with Sri Matha Yellamanba Services through CSR. Transparent impact, alignment with SDGs 4, 5, 8 and 10, and scalable community projects."
  overlay
>
  <PageHero
    eyebrow="CSR Fund"
    title={csr.heading}
    lead={csr.lead}
    image="/images/view-woman-working-agricultural-sector-celebrate-labour-day-women-scaled-e1759644108590.jpg"
  />

  <!-- Why partner -->
  <section class="section-y">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow" data-reveal="fade"><span class="eyebrow-dot"></span>Why partner with us</p>
        <h2 class="h2 mt-5" data-split-text>Three reasons corporates choose SMY</h2>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-3" data-reveal-group>
        {
          csr.reasons.map((r, i) => (
            <article class="card p-7">
              <span class="csr__index">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="h3 mt-5">{r.title}</h3>
              <p class="mt-2.5 text-[0.9375rem] leading-relaxed" style="color: var(--c-muted)">
                {r.body}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Focus areas -->
  <section class="section-y pt-0">
    <div class="container-x">
      <div class="grid gap-6 md:grid-cols-2">
        {
          csr.focusAreas.map((f) => (
            <article class="focus">
              <h3 class="h2" data-split-text>
                {f.title}
              </h3>
              <ul class="mt-6 space-y-3" data-reveal-group data-reveal-stagger="0.07">
                {f.points.map((p) => (
                  <li class="flex gap-3 text-[0.9375rem]">
                    <span class="check" aria-hidden="true">
                      ✓
                    </span>
                    <span style="color: var(--c-muted)">{p}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Partnership models -->
  <section class="section-y" style="background: var(--c-surface)">
    <div class="container-x">
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div>
          <p class="eyebrow" data-reveal="fade"><span class="eyebrow-dot"></span>How it works</p>
          <h2 class="h2 mt-5" data-split-text>Partnership models</h2>
          <p class="lead mt-6" data-reveal="up">
            Pick the structure that fits your CSR policy. We adapt reporting to your compliance calendar.
          </p>
          <div class="mt-8 flex flex-wrap gap-4" data-reveal="up">
            <a href={u('/contact/')} class="btn btn-primary">
              Talk to us
              <Icon name="arrow-right" class="btn-arrow" />
            </a>
            <a href={u('/certificate/')} class="btn btn-outline">View certificates</a>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2" data-reveal-group>
          {
            csr.models.map((m) => (
              <div class="model">
                <span class="icon-badge">
                  <Icon name="shield" />
                </span>
                <p class="font-display mt-4 font-semibold">{m}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- SDG + compliance -->
  <section class="section-y">
    <div class="container-x">
      <div class="compliance">
        <div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-center">
          <div>
            <h2 class="h2" data-split-text>Aligned with national priorities</h2>
            <p class="lead mt-5 max-w-xl" data-reveal="up">
              Our programmes map directly to UN Sustainable Development Goals 4 (Quality Education), 5
              (Gender Equality), 8 (Decent Work &amp; Economic Growth) and 10 (Reduced Inequalities).
            </p>
            <div class="mt-7 flex flex-wrap gap-2.5" data-reveal-group data-reveal-stagger="0.07">
              {sdgs.map((s) => <span class="sdg">{s}</span>)}
            </div>
          </div>

          <dl class="reg">
            <div><dt>CSR registration</dt><dd>{org.csr}</dd></div>
            {donate.bank.account && <div><dt>Account no.</dt><dd>{donate.bank.account}</dd></div>}
            {donate.bank.ifsc && <div><dt>IFSC</dt><dd>{donate.bank.ifsc}</dd></div>}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title="Let us build a programme together"
    body="Tell us your CSR focus and budget cycle. We will come back with a costed project plan and a reporting schedule."
  />
</BaseLayout>

<style>
  .csr__index {
    display: inline-grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 0.9rem;
    background: var(--c-brand-soft);
    color: var(--c-brand);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.85rem;
  }

  .focus {
    border: 1px solid var(--c-line);
    border-radius: 1.35rem;
    padding: clamp(1.75rem, 3vw, 2.5rem);
  }

  .model {
    border: 1px solid var(--c-line);
    border-radius: 1.1rem;
    padding: 1.5rem;
    background: var(--c-bg);
  }

  .compliance {
    border: 1px solid var(--c-line);
    border-radius: 1.75rem;
    padding: clamp(1.75rem, 4vw, 3.25rem);
    background: var(--c-brand-soft);
  }

  .sdg {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 600;
    background: var(--c-bg);
    border: 1px solid var(--c-line);
    border-radius: 999px;
    padding: 0.5rem 1rem;
  }

  .reg {
    background: var(--c-ink);
    color: #fff;
    border-radius: 1.25rem;
    padding: 1.75rem;
    display: grid;
    gap: 1rem;
    min-width: 17rem;
  }

  .reg div {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    padding-bottom: 0.75rem;
    font-size: 0.875rem;
  }

  .reg div:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .reg dt {
    color: rgba(255, 255, 255, 0.55);
  }

  .reg dd {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
</style>
