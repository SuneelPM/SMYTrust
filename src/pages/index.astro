---
import { u } from '../lib/url';
import Picture from '../components/Picture.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import StatsBar from '../components/StatsBar.astro';
import CausesGrid from '../components/CausesGrid.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import LeadershipGrid from '../components/LeadershipGrid.astro';
import { org, about, services, team, csr } from '../data/site';
import { gallery } from '../data/media';
---

<BaseLayout
  title={org.name}
  description={`${org.name} — a registered service organisation in Vijayawada working in education, child health, healthcare, environment, women empowerment and disaster relief.`}
  overlay
>
  <HeroCarousel />
  <StatsBar />
  <CausesGrid />

  <!-- ================= PROJECT ================= -->
  <section class="project section-y">
    <div class="container-x">
      <div class="project__grid">
        <div>
          <p class="eyebrow" data-reveal="fade"><span class="eyebrow-dot"></span>The Project</p>
          <h2 class="h2 mt-5" data-split-text>SMYS Vidya Seva Initiative</h2>
        </div>
        <div class="project__body" data-reveal="up">
          <p>
            The SMYS Vidya Seva Initiative (SMYS-VSI), subtitled the Comprehensive School Support &amp;
            Development Programme, is a multi-component Government-school development initiative for
            Andhra Pradesh.
          </p>
          <p>
            Its distinguishing feature is that it does not treat a school as a single deficiency to be
            corrected. A school where the computer laboratory is new but the girls' toilet is unusable
            is not a functioning school; nor is a school with sound classrooms and no safe drinking
            water.
          </p>
          <p>
            SMYS-VSI therefore assesses and improves the whole school environment across forty defined
            objectives spanning classroom and civil infrastructure, electrical infrastructure, digital
            infrastructure and school administration, sanitation, safe drinking water, environment,
            sports and support manpower, together with the maintenance and monitoring that keep those
            improvements working.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= ABOUT ================= -->
  <section class="section-y" style="background: var(--c-surface)">
    <div class="container-x">
      <div class="grid gap-14 lg:grid-cols-2 lg:gap-20">
        <div class="relative" data-reveal="left">
          <div class="about__media">
            <Picture src={u(about.image)}
              alt="Children supported by SMY Services programmes"
              class="media-cover"
              data-parallax="45"
              width="900"
              height="760"
              loading="lazy" sizes="(min-width: 1024px) 50vw, 100vw" />
          </div>
          <div class="about__badge">
            <span class="about__badge-num">3+</span>
            <span class="text-[11px] leading-tight tracking-wide uppercase" style="color: var(--c-muted)"
              >Years serving<br />Visakhapatnam</span
            >
          </div>
        </div>

        <div class="lg:pt-4">
          <p class="eyebrow" data-reveal="fade"><span class="eyebrow-dot"></span>{about.kicker}</p>
          <h2 class="h2 mt-5" data-split-text>{about.heading}</h2>
          <p class="lead mt-6" data-reveal="up">{about.lead}</p>

          <div class="mt-6 space-y-4 leading-relaxed" style="color: var(--c-muted)" data-reveal-group>
            {about.body.map((p) => <p>{p}</p>)}
          </div>

          <div class="mt-9 flex flex-wrap gap-4" data-reveal="up">
            <a href={u('/about/')} class="btn btn-primary">Our story<Icon name="arrow-right" class="btn-arrow" /></a>
            <a href={u('/services/')} class="btn btn-outline">What we do</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= SERVICES ================= -->
  <section class="section-y">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <p class="eyebrow" data-reveal="fade"><span class="eyebrow-dot"></span>Our focus areas</p>
          <h2 class="h2 mt-5" data-split-text>Programmes running today</h2>
        </div>
        <a href={u('/services/')} class="btn btn-outline" data-reveal="fade">
          All services<Icon name="arrow-right" class="btn-arrow" />
        </a>
      </div>

      <div class="mt-14 grid gap-7 md:grid-cols-2 lg:grid-cols-4" data-reveal-group data-reveal-stagger="0.12">
        {
          services.map((s, i) => (
            <article class="card group overflow-hidden">
              <div class="svc__media">
                <Picture src={u(s.image)}
                  alt={s.title}
                  class="media-cover transition-transform duration-[1000ms] group-hover:scale-[1.07]"
                  width="600"
                  height="420"
                  loading="lazy" sizes="(min-width: 1024px) 50vw, 100vw" />
                <span class="svc__num">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <div class="p-7">
                <h3 class="h3">{s.title}</h3>
                <p class="mt-3 text-[0.9375rem] leading-relaxed" style="color: var(--c-muted)">
                  {s.summary}
                </p>
                <ul class="mt-5 space-y-2 text-sm">
                  {s.points.slice(0, 4).map((p) => (
                    <li class="flex gap-2.5">
                      <span class="tick" aria-hidden="true" />
                      <span style="color: var(--c-muted)">{p}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= CSR ================= -->
  <section class="csr">
    <div class="csr__bg" data-parallax="60" aria-hidden="true">
      <Picture
        src={u('/images/environment-scaled.jpg')}
        alt=""
        class="media-cover"
        width="1920"
        height="900"
        loading="lazy"
        sizes="100vw"
      />
    </div>
    <div class="container-x relative">
      <div class="max-w-2xl">
        <p class="eyebrow eyebrow--light" data-reveal="fade">
          <span class="eyebrow-dot"></span>CSR partnership
        </p>
        <h2 class="h2 mt-5 text-white" data-split-text>{csr.heading}</h2>
        <p class="mt-6 text-lg leading-relaxed text-white/75" data-reveal="up">{csr.lead}</p>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-3" data-reveal-group>
        {
          csr.reasons.map((r) => (
            <div class="csr__card">
              <h3 class="h3 text-white">{r.title}</h3>
              <p class="mt-2.5 text-sm leading-relaxed text-white/65">{r.body}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-10" data-reveal="up">
        <a href={u('/csr-fund/')} class="btn btn-primary btn-lg">
          Explore CSR partnership<Icon name="arrow-right" class="btn-arrow" />
        </a>
      </div>
    </div>
  </section>

  <!-- ================= TEAM ================= -->
  <section class="section-y">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow" data-reveal="fade"><span class="eyebrow-dot"></span>Leadership</p>
        <h2 class="h2 mt-5" data-split-text>The team behind the work</h2>
      </div>

      <LeadershipGrid members={team} />
    </div>
  </section>

  <!-- ================= GALLERY ================= -->
  <section class="section-y pt-0">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-5">
        <div>
          <p class="eyebrow" data-reveal="fade"><span class="eyebrow-dot"></span>Gallery</p>
          <h2 class="h2 mt-5" data-split-text>Moments from the field</h2>
        </div>
        <a href={u('/gallery/')} class="btn btn-outline" data-reveal="fade">
          {gallery.length > 0 ? `View all ${gallery.length} photos` : 'View gallery'}<Icon name="arrow-right" class="btn-arrow" />
        </a>
      </div>

      {
        gallery.length > 0 ? (
          <div
            class="mt-12 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4"
            data-reveal-group
            data-reveal-stagger="0.05"
          >
            {
              gallery.slice(0, 8).map((g) => (
                <figure class="gal">
                  <Picture src={u(g.src)} alt={g.alt} class="media-cover" width="480" height="480" loading="lazy" sizes="(min-width: 1024px) 50vw, 100vw" />
                </figure>
              ))
            }
          </div>
        ) : (
          <div class="placeholder mt-10 max-w-2xl" data-reveal="fade">
            <span class="placeholder__tag">Photos in progress</span>
            <p class="mt-2 text-sm leading-relaxed" style="color: var(--c-muted)">
              New photographs from recent field service activities and community programmes are being curated and will be uploaded soon.
            </p>
          </div>
        )
      }
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .about__media {
    aspect-ratio: 6 / 5;
    border-radius: 1.5rem;
    overflow: hidden;
    box-shadow: 0 40px 80px -38px hsl(222 47% 11% / 0.35);
  }

  .project {
    background: var(--c-bg);
    border-top: 1px solid var(--c-line);
  }

  .project__grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .project__grid {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 5rem;
      align-items: start;
    }
  }

  .project__body {
    display: grid;
    gap: 1.1rem;
    color: var(--c-muted);
    font-size: 1.02rem;
    line-height: 1.85;
  }

  .about__media img {
    height: 118%;
    margin-top: -9%;
  }

  .about__badge {
    position: absolute;
    right: -0.75rem;
    bottom: -1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--c-bg);
    border-radius: 1.1rem;
    padding: 1.15rem 1.4rem;
    box-shadow: 0 24px 50px -24px hsl(222 47% 11% / 0.35);
  }

  .about__badge-num {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    font-weight: 800;
    color: var(--c-brand);
  }

  .svc__media {
    position: relative;
    aspect-ratio: 16 / 11;
    overflow: hidden;
  }

  .svc__num {
    position: absolute;
    top: 1rem;
    left: 1rem;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    background: rgba(255, 255, 255, 0.94);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
  }

  .csr {
    position: relative;
    overflow: hidden;
    background: var(--c-ink);
    padding-block: clamp(4rem, 8vw, 7rem);
    isolation: isolate;
  }

  .csr__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 130%;
    opacity: 0.18;
    z-index: -1;
    overflow: hidden;
  }

  .csr__card {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(10px);
    border-radius: 1.25rem;
    padding: 1.85rem;
  }

  .gal {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 0.9rem;
    background: var(--c-surface);
  }

  .gal img {
    transition: transform 1s var(--ease-out-expo);
  }

  .gal:hover img {
    transform: scale(1.07);
  }
</style>
