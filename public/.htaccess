# =============================================================
#  Sri Matha Yellamanba Services — Apache config for Hostinger
#  Shared hosting (LiteSpeed/Apache). Upload with the site to
#  public_html/. Static site: no rewrites to an app server.
# =============================================================

# ---- Default document ----------------------------------------
DirectoryIndex index.html

# ---- Force HTTPS and drop the www prefix ---------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # www -> non-www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # ---- Redirects from the old WordPress URLs -----------------
  RewriteRule ^about-us/?$            /about/           [R=301,L]
  RewriteRule ^contact-us/?$          /contact/         [R=301,L]
  RewriteRule ^donate-now/?$          /donate/          [R=301,L]
  RewriteRule ^refund-and-cancellation-policy/?$ /refund-policy/ [R=301,L]
  RewriteRule ^terms-conditions/?$    /terms-conditions/ [R=301,L]

  # Old media library paths -> local images
  RewriteRule ^wp-content/uploads/[0-9]{4}/[0-9]{2}/(.+)$ /images/$1 [R=301,L]

  # Retire WordPress endpoints rather than 404-ing them slowly
  RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php|wp-json) - [R=410,L]

  # ---- Pretty URLs: serve /about/ from /about/index.html -----
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# ---- Custom error page ---------------------------------------
ErrorDocument 404 /404.html

# ---- Compression ---------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ---- Caching -------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Fingerprinted build assets never change: cache hard.
  <FilesMatch "\.(js|css)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images and fonts
  ExpiresByType image/webp                "access plus 6 months"
  ExpiresByType image/jpeg                "access plus 6 months"
  ExpiresByType image/png                 "access plus 6 months"
  ExpiresByType image/svg+xml             "access plus 6 months"
  ExpiresByType font/woff2                "access plus 1 year"

  # HTML must revalidate so content edits go live immediately.
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # ---- Security headers --------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Remove the ETag/Server noise
  Header unset X-Powered-By
</IfModule>

# ---- Correct MIME types --------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# ---- Block access to dotfiles --------------------------------
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Directory listing off
Options -Indexes
