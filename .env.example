# Copy to .env and fill in. .env is git-ignored.

# Contact form delivery - free key from https://web3forms.com
PUBLIC_WEB3FORMS_KEY=

# Bank transfer details shown on /donate/ and /csr-fund/.
# Deliberately kept out of version control: the public repo should not carry
# the trust's account identifiers. Leave blank and the donate page shows a
# "details available on request" panel instead of the table.
PUBLIC_BANK_ACCOUNT_NAME=Sri Matha Yellamanba Services
PUBLIC_BANK_ACCOUNT=
PUBLIC_BANK_CIF=
PUBLIC_BANK_IFSC=
PUBLIC_BANK_MICR=
PUBLIC_BANK_PRODUCT=
PUBLIC_BANK_EMAIL=
